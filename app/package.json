{
  "name": "finsense-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "BASE_PATH=/finsense-ai/ tsc -b && BASE_PATH=/finsense-ai/ vite build",
    "preview": "vite preview",
    "lint": "oxlint src",
    "typecheck": "tsc -b --noEmit false",
    "test": "vitest run",
    "test:ml": "node scripts/ml-tests.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:all": "npm run lint && npm run test && npm run test:ml && npm run build && npm run test:e2e",
    "ml:evaluate": "node scripts/evaluate-ml.mjs",
    "test:live": "node scripts/live-check.mjs"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "lucide-react": "^1.66.0",
    "pyodide": "^314.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}